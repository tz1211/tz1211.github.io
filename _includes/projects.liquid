<div class="col">
  <div class="card h-100 hoverable">
    {% if project.img %}
      {%
        include figure.liquid
        loading="eager"
        path=project.img
        sizes = "250px"
        alt="project thumbnail"
        class="card-img-top"
      %}
    {% endif %}
    <div class="card-body">
      <h2 class="card-title">{{ project.title }}</h2>
      <p class="card-text">{{ project.description }}</p>
      <div class="project-links mt-2">
        {% if project.github or project.code %}
          <a class="btn btn-sm btn-outline-primary me-1 mb-1" href="{{ project.github | default: project.code }}" target="_blank" rel="noopener noreferrer">Code</a>
        {% endif %}
        {% if project.paper %}
          <a class="btn btn-sm btn-outline-primary me-1 mb-1" href="{{ project.paper }}" target="_blank" rel="noopener noreferrer">Paper</a>
        {% endif %}
        {% if project.post %}
          <a class="btn btn-sm btn-outline-primary me-1 mb-1" href="{{ project.post }}" target="_blank" rel="noopener noreferrer">Post</a>
        {% endif %}
      </div>
      {% if project.github_stars %}
        <div class="github-icon mt-1">
          <span class="stars" data-toggle="tooltip" title="GitHub Stars">
            <i class="fa-solid fa-star"></i>
            <span id="{{ project.github_stars }}-stars"></span>
          </span>
        </div>
      {% endif %}
    </div>
  </div>
</div>
